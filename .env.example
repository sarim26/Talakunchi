# ===== AI / Gemini =====
AI_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# ===== Worker scan mode (recon/scanning) =====
# agent = uses Gemini tool-calling (execute_command) for scanning
SCAN_MODE=agent
AGENT_ENABLED=true

# How many Gemini steps per scan (commands run until completion — no wall-clock kill)
AGENT_MAX_STEPS=25

# Optional global scope fallback (IPs/CIDRs/hostnames). Per-target scope on Targets page is preferred.
# Merged with each target's address, vhost, and scope field at run time.
AGENT_SCOPE=

# ===== Agentic recon (MCP) models + policy =====
# OLLAMA_MANAGER_MODEL=qwen3:8b
# OLLAMA_PROMPTER_MODEL=qwen3:14b
# OLLAMA_SPECIALIST_MODEL=qwen2.5-coder:7b
# OLLAMA_COMMAND_WRITER_MODEL=qwen2.5-coder:7b
RECON_MAX_STEPS=20
# readonly (default) or gated_exploit (exposes recon.hydra + exploit jobs behind approvals)
RECON_MODE=readonly
# Max time a gated tool waits for a command approval before skipping (ms)
APPROVAL_WAIT_MS=120000
# Allowlist (comma/space separated prefixes) of exploit commands permitted in gated mode
EXPLOIT_COMMAND_ALLOWLIST=

# ===== Optional online CVE enrichment (offline heuristics remain default) =====
# CVE_FEED_URL=
# NVD_API_KEY=

# ===== Optional OSINT connectors (tools no-op without keys) =====
# SHODAN_API_KEY=
# CENSYS_API_ID=
# CENSYS_API_SECRET=
# SECURITYTRAILS_API_KEY=

# ===== Hydra credential attacks (used during scan stage in worker) =====
HYDRA_ENABLED=true

# Either set single creds OR use lists below (lists are recommended)
# HYDRA_USERNAME=
# HYDRA_PASSWORD=

# Paths on your SSH Kali machine (Hydra runs there, not in Docker):
HYDRA_USERLIST=/home/kali/Desktop/SecLists/Usernames/top-usernames-shortlist.txt
HYDRA_PASSLIST=/home/kali/Desktop/SecLists/Passwords/Common-Credentials/10-million-password-list-top-10000.txt

HYDRA_STOP_ON_FIRST_FIND=false
HYDRA_THREADS=10

# ===== Gated exploit tools (agentic exploit phase; each requires Pipeline approval) =====
SQLMAP_ENABLED=true
MSF_ENABLED=true
COMMIX_ENABLED=true
CRACKMAPEXEC_ENABLED=true
# Optional override; empty uses built-in lab-friendly MSF modules
# MSF_MODULE_ALLOWLIST=exploit/unix/ftp/vsftpd_234_backdoor,exploit/linux/samba/is_known_pipename
EXPLOIT_LHOST_ALLOWLIST=

# ===== Required: SSH Kali box (every tool runs here; Docker only runs Node) =====
REMOTE_SSH_HOST=192.168.1.50
REMOTE_SSH_USER=kali
REMOTE_SSH_PORT=22
REMOTE_SSH_STRICT_HOST_KEY_CHECKING=accept-new
# Provide one auth method:
#REMOTE_SSH_IDENTITY_FILE=/root/.ssh/id_ed25519
REMOTE_SSH_PASSWORD="replace-with-strong-password-or-use-key-above"

# ===== Nmap scan behavior =====
NMAP_ARGS="-Pn -vvv --reason --stats-every 5s -sV --version-light --top-ports 200"
POLL_INTERVAL_MS=1500

# ===== Phase 4 AI exploitation (optional auto-trigger) =====
# If you don’t want it to auto-run, set to false
EXPLOIT_ENABLED=true

EXPLOIT_MAX_STEPS=15

# If empty, worker allows callbacks on loopback + its local IPv4s.
# To override explicitly, set:  EXPLOIT_LHOST_ALLOWLIST=127.0.0.1,1.2.3.4
EXPLOIT_LHOST_ALLOWLIST=